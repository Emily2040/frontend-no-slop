{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Emily2040/frontend-no-slop/schemas/runtime-compact.json",
  "title": "Frontend No-Slop Runtime Output",
  "description": "Compact audit output for quick frontend critique with evidence, prioritized fixes, state gaps, accessibility, performance, and copy flags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page_type",
    "summary",
    "evidence",
    "fixes",
    "state_gaps",
    "a11y_flags",
    "performance_flags",
    "copy_flags",
    "next_steps"
  ],
  "properties": {
    "page_type": {
      "type": "string",
      "description": "Primary page or surface lens. Values must match the page-type registry.",
      "enum": [
        "landing-page",
        "dashboard",
        "docs",
        "settings",
        "onboarding",
        "data-table",
        "form",
        "modal-dialog",
        "design-system",
        "app-shell"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "fixes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "issue",
          "action"
        ],
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "p0",
              "p1",
              "p2"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "a11y_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "performance_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "copy_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

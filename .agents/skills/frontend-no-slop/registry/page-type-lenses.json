{
  "page_types": [
    {
      "name": "landing-page",
      "primary_user_job": "Understand the offer quickly and choose a meaningful next step.",
      "critical_elements": [
        "clear promise",
        "proof",
        "primary CTA",
        "secondary path",
        "objection handling"
      ],
      "slop_traps": [
        "giant empty hero",
        "buzzword feature grid",
        "proof with no context",
        "CTA overload"
      ],
      "failure_modes": [
        "buried product evidence",
        "copy that says little",
        "sections that do not advance the decision"
      ]
    },
    {
      "name": "dashboard",
      "primary_user_job": "Read current state, detect change, and act without hunting for controls.",
      "critical_elements": [
        "status summary",
        "filters",
        "time context",
        "table or chart detail",
        "row or drill-in actions"
      ],
      "slop_traps": [
        "decorative charts",
        "neon metrics with no action",
        "filters hidden in side panels"
      ],
      "failure_modes": [
        "no visible default time range",
        "weak empty states",
        "actions detached from the data they affect"
      ]
    },
    {
      "name": "docs",
      "primary_user_job": "Find the right answer fast and copy a correct implementation.",
      "critical_elements": [
        "clear information scent",
        "version context",
        "working examples",
        "copyable code",
        "next-step links"
      ],
      "slop_traps": [
        "marketing headlines inside docs",
        "walls of text",
        "missing prerequisites"
      ],
      "failure_modes": [
        "buried examples",
        "unclear navigation",
        "no expected output or result"
      ]
    },
    {
      "name": "settings",
      "primary_user_job": "Change configuration safely and understand side effects before saving.",
      "critical_elements": [
        "grouping",
        "destructive action separation",
        "defaults",
        "help text",
        "confirmation and rollback paths"
      ],
      "slop_traps": [
        "dense unlabeled forms",
        "dangerous actions near routine actions"
      ],
      "failure_modes": [
        "unclear scope",
        "missing save state",
        "no warning for irreversible actions"
      ]
    },
    {
      "name": "onboarding",
      "primary_user_job": "Complete setup with low anxiety and visible progress.",
      "critical_elements": [
        "step framing",
        "progress",
        "requirements",
        "success cues",
        "escape or skip rules"
      ],
      "slop_traps": [
        "cute illustrations instead of guidance",
        "unclear completion criteria"
      ],
      "failure_modes": [
        "too many fields upfront",
        "no explanation of why information is needed"
      ]
    },
    {
      "name": "data-table",
      "primary_user_job": "Scan, compare, filter, and act on rows efficiently.",
      "critical_elements": [
        "column clarity",
        "filtering",
        "sorting",
        "density control",
        "bulk actions",
        "empty/loading states"
      ],
      "slop_traps": [
        "pretty table with weak utility",
        "actions hidden in hover only"
      ],
      "failure_modes": [
        "truncation without reveal",
        "no keyboard row action path",
        "mobile collapse that loses meaning"
      ]
    },
    {
      "name": "form",
      "primary_user_job": "Enter required information, recover from mistakes, and submit with confidence.",
      "critical_elements": [
        "visible labels",
        "helper text",
        "validation timing",
        "error recovery",
        "success confirmation",
        "keyboard flow"
      ],
      "slop_traps": [
        "placeholder-only labels",
        "validation only after submit",
        "disabled submit with no reason"
      ],
      "failure_modes": [
        "unclear required fields",
        "errors detached from inputs",
        "no saved or submitted confirmation"
      ]
    },
    {
      "name": "modal-dialog",
      "primary_user_job": "Complete or dismiss a focused task without losing context.",
      "critical_elements": [
        "clear title",
        "focused primary action",
        "escape path",
        "focus trap",
        "return focus",
        "stacking rules"
      ],
      "slop_traps": [
        "modal used for routine content",
        "unclear cancel behavior",
        "background remains keyboard reachable"
      ],
      "failure_modes": [
        "focus starts in the wrong place",
        "destructive action is visually equal to cancel",
        "dialog content overflows on mobile"
      ]
    },
    {
      "name": "design-system",
      "primary_user_job": "Define reusable primitives, variants, and rules so product surfaces stay consistent.",
      "critical_elements": [
        "tokens",
        "component variants",
        "state matrix",
        "usage rules",
        "accessibility defaults",
        "migration notes"
      ],
      "slop_traps": [
        "tokens with no usage guidance",
        "component variants without states",
        "brand adjectives replacing implementation rules"
      ],
      "failure_modes": [
        "teams cannot tell which variant to use",
        "states diverge across products",
        "accessibility is left to each implementation"
      ]
    },
    {
      "name": "app-shell",
      "primary_user_job": "Navigate between product areas, understand current location, and keep primary work visible.",
      "critical_elements": [
        "navigation hierarchy",
        "current location",
        "responsive collapse",
        "search or command access",
        "account or workspace switcher",
        "keyboard reachability"
      ],
      "slop_traps": [
        "decorative sidebar chrome",
        "collapsed navigation with hidden meaning",
        "global actions detached from context"
      ],
      "failure_modes": [
        "current section is not announced or visible",
        "mobile nav traps focus",
        "workspace scope is unclear"
      ]
    }
  ]
}
